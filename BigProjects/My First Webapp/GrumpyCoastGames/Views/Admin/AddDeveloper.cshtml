@model GrumpyCoastGames.Models.Developer

<h2>Add New Team Member</h2>

<form asp-action="AddDeveloper" method="post" enctype="multipart/form-data">
    <div asp-validation-summary="All" class="text-danger"></div>
    <div class="container border border-danger round-2 p-3">
        <div class="mb-3">
            <label asp-for="Name" class="form-label"></label>
            <input asp-for="Name" class="form-control" />
            <span asp-validation-for="Name" class="text-danger"></span>
        </div>
        <div class="mb-3">
            <label asp-for="Description" class="form-label"></label>
            <textarea asp-for="Description" class="form-control" rows="4"></textarea>
            <span asp-validation-for="Description" class="text-danger"></span>
        </div>
        <div class="mb-3">
            <label asp-for="Position" class="form-label"></label>
            <input asp-for="Position" class="form-control" />
            <span asp-validation-for="Position" class="text-danger"></span>
        </div>
        <div class="mb-3">
            <label class="form-label">Developer Picture</label>
            <input type="file" name="imageFile" class="form-control" accept="image/*" />
        </div>
     </div>
    <div class="p-2"></div>
    <button type="submit" class="btn btn-primary">Save Developer</button>
    <a asp-action="Developers" class="btn btn-secondary">Cancel</a>
</form>