@model GrumpyCoastGames.Models.Developer

<h2>Edit Team Members</h2>

<form asp-action="EditDeveloper" method="post" enctype="multipart/form-data">
    <input type="hidden" asp-for="ID" />
    <div class="container border border-danger round-2 p-3">
        <div class="mb-3">
            <label asp-for="Name" class="form-label"></label>
            <input asp-for="Name" class="form-control" />
            <span asp-validation-for="Name" class="text-danger"></span>
        </div>
        <div class="mb-3">
            <label asp-for="Description" class="form-label"></label>
            <textarea asp-for="Description" class="form-control" rows="4"></textarea>
            <span asp-validation-for="Description" class="text-danger"></span>
        </div>
        <div class="mb-3">
            <label asp-for="Position" class="form-label"></label>
            <input asp-for="Position" class="form-control" />
            <span asp-validation-for="Position" class="text-danger"></span>
        </div>
        @if (!string.IsNullOrEmpty(Model.Image))
        {
            <div class="mb-3">
                <label class="form-label">Current Image</label>
                <img src="@Model.Image" height="100" />
            </div>
        }
        <div class="mb-3">
            <label class="form-label">Upload Image</label>
            <input type="file" name="imageFile" class="form-control" accept="image/*" />
        </div>
    </div>
    <div class="p-2"> </div>
    <button type="submit" class="btn btn-primary">Save Developer</button>
    <a asp-action="Developers" class="btn btn-secondary">Cancel</a>
</form>