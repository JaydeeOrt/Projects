@{
    Layout = "_Layout";
}
<style>
    .carousel-item img {
        height: 750px;
        object-fit: contain;
        width: 100%;
    }

    .video-container{
        width:100%;
        margin:0 auto;
    }

</style>
<h2 style="text-align: center" class="p-4">THIS IS OUR MEDIA PAGE</h2>

<div id="GameCarousel" class="carousel slide mx-auto" data-bs-ride="carousel">
    <div class="carousel-indicators">
        <button type="button" data-bs-target="#GameCarousel" data-bs-slide-to="0" class="active" aria-current="true" aria-label="Slide 1"></button>
        <button type="button" data-bs-target="#GameCarousel" data-bs-slide-to="1" aria-label="Slide 2"></button>
        <button type="button" data-bs-target="#GameCarousel" data-bs-slide-to="2" aria-label="Slide 3"></button>
        <button type="button" data-bs-target="#GameCarousel" data-bs-slide-to="3" aria-label="Slide 4"></button>
    </div>


    <div class="carousel-inner">
        <div class="carousel-item active">
            <img src="~/images/Glorpys Revenge Box.png" class="d-block w-100" alt="Revenge of Glorpy" />

            <div class="carousel-caption d-none d-md-block">
                <h5>Glorpys Revenge</h5>
            </div>

        </div>

        <div class="carousel-item">
            <img src="~/Images/A Mage Game Box.png" class="d-block w-100" alt="A Mage Game" />

            <div class="carousel-caption d-none d-md-block">
                <h5>A Mage Game</h5>
            </div>

        </div>

        <div class="carousel-item">
            <img src="~/Images/Glorpy Survivors.png" class="d-block w-100" alt="Glorpy Survivors" />

            <div class="carousel-caption d-none d-md-block">
                <h5>Glorpy Survivors</h5>
            </div>

        </div>

        <div class="carousel-item">
            <img src="~/Images/Fake StolenPhasmoKaisen.jpg" class="d-block w-100" alt="Fake StolenPhasmoKaisen" />

            <div class="carousel-caption d-none d-md-block">
                <h5>Fake Stolen PhasmoKaisen</h5>
            </div>

        </div>

      

    </div> 
    <button class="carousel-control-prev" type="button" data-bs-target="#GameCarousel" data-bs-slide="prev">
        <span class="carousel-control-prev-icon" aria-hidden="true"></span>
        <span class="visually-hidden">Previous</span>
    </button>
    <button class="carousel-control-next " type="button" data-bs-target="#GameCarousel" data-bs-slide="next">
        <span class="carousel-control-next-icon" aria-hidden="true"></span>
        <span class="visually-hidden">Next</span>
    </button>
</div>



<div class="container d-flex justify-content-center p-5">
    <iframe width="1500" height="500" src="https://www.youtube.com/embed/xLAYmXvLJpQ?si=yveWddxXJt5-bg82" title="YouTube video player" frameborder="0" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share" referrerpolicy="strict-origin-when-cross-origin" allowfullscreen></iframe>
</div>



<div class="accordion" id="MediaAccordionPanel" data-bs-theme="dark">
    <div class="accordion-item align-item">
        <h2 class="accordion-header" id="panelsStayOpen-headingOne">
            <button class="accordion-button" type="button" data-bs-toggle="collapse" data-bs-target="#panelsStayOpen-collapseOne" aria-expanded="true" aria-controls="panelsStayOpen-collapseOne">
                <strong>Glorpys Revenge Assets</strong>
            </button>
        </h2>
        <div id="panelsStayOpen-collapseOne" class="accordion-collapse collapse show" aria-labelledby="panelsStayOpen-headingOne">
            <div class="accordion-body text-center">

                <div class="row row-cols-1 row-cols-md-2 g-5">
                     <div class="col">
                            <div class="card h-100">
                                <img src="~/Images/Assets/GlorpyHead50.png" class="card-img-top" alt="Glorpys Head" style="height: 200px; object-fit: contain;" />
                                <div class="card-body">
                                    <h5 class="card-title">Glorpys Head</h5>
                                    <p class="card-text">This is the head of the Glorpy goliath. Dont let his cute face fool you he is a monster</p>
                                </div>
                            </div>
                    </div>

                    <div class="col">
                        <div class="card h-100">
                            <img src="~/Images/Assets/GlorpyBody50.png" class="card-img-top" alt="Glorpys Body" style="height: 200px; object-fit: contain;" />
                            <div class="card-body">
                                <h5 class="card-title">Glorpys Body</h5>
                                <p class="card-text">This is Glorpys Body said to be able to eat planets</p>
                            </div>
                        </div>
                    </div>

                    <div class="col">
                        <div class="card h-100">
                            <img src="~/Images/Assets/GlorpyTail50.png" class="card-img-top" alt="Glorpys Tail" style="height: 200px; object-fit: contain;" />
                            <div class="card-body">
                                <h5 class="card-title">Glorpys Tail</h5>
                                <p class="card-text">This is Glorpys Tail Some may say it still has not left their home planet</p>
                            </div>
                        </div>
                    </div>

                    <div class="col">
                        <div class="card h-100">
                            <img src="~/Images/Assets/Planet1-50.png" class="card-img-top" alt="Planet 1" style="height: 200px; object-fit: contain;" />
                            <div class="card-body">
                                <h5 class="card-title">Planet ? </h5>
                                <p class="card-text">This is one of the many planets in the glorpy galaxy, we do not know its name</p>
                            </div>
                        </div>
                    </div>
                    <div class="col">
                        <div class="card h-100">
                            <img src="~/Images/Assets/Planet2-50.png" class="card-img-top" alt="Planet 2" style="height: 200px; object-fit: contain;" />
                            <div class="card-body">
                                <h5 class="card-title">Planet ? </h5>
                                <p class="card-text">This is another of the many planets in the glorpy galaxy, we do not know its name</p>
                            </div>
                        </div>
                    </div>
                </div>


            </div>
        </div>
    </div>


    <div class="accordion-item">
        <h2 class="accordion-header " id="panelsStayOpen-headingTwo">
            <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#panelsStayOpen-collapseTwo" aria-expanded="false" aria-controls="panelsStayOpen-collapseTwo">
                <strong> Glorpy Survivors</strong>
            </button>
        </h2>
        <div id="panelsStayOpen-collapseTwo" class="accordion-collapse collapse" aria-labelledby="panelsStayOpen-headingTwo">
            <div class="accordion-body  text-center">


                <div class="row row-cols-1 row-cols-md-2 g-5">
                    <div class="col">
                        <div class="card h-100">
                            <img src="~/Images/Assets/SawedOffRayGun48.png" class="card-img-top" alt="Sawed off Raygun" style="height: 200px; object-fit: contain;" />
                            <div class="card-body">
                                <h5 class="card-title">Sawed off Raygun</h5>
                                <p class="card-text">This is a upscaled asset made as one of your weapon choices for Glorpy Survivors</p>
                                <p class="card-footer">This is technology found on the planet, with a little human additions</p> 
                            </div>
                        </div>
                    </div>

                    <div class="col">
                        <div class="card h-100">
                            <img src="~/Images/Assets/Glorp48.png" class="card-img-top" alt="Glorp" style="height: 200px; object-fit: contain;" />
                            <div class="card-body">
                                <h5 class="card-title">Glorp</h5>
                                <p class="card-text">Glorpy the alien</p>
                                <p class="card-footer">This is one of the natives of the planet</p>
                            </div>
                        </div>
                    </div>

                    <div class="col">
                        <div class="card h-100">
                            <img src="~/Images/Assets/AlienGrassOld48.png" class="card-img-top" alt="Old Grass" style="height: 200px; object-fit: contain;" />
                            <div class="card-body">
                                <h5 class="card-title">Alien Grass V1</h5>
                                <p class="card-text">This grass from the alien planet of our game. After recieving some feedback we decided on changing the colors and making it so it would look continuous</p>
                            </div>
                        </div>
                    </div>

                    <div class="col">
                        <div class="card h-100">
                            <img src="~/Images/Assets/AlienGrassF48.png" class="card-img-top" alt="Alien Grass" style="height: 200px; object-fit: contain;" />
                            <div class="card-body">
                                <h5 class="card-title">Alien Grass V2</h5>
                                <p class="card-text">This grass from the alien planet of our game. After recieving some feedback this one quickly became a fan favorite</p>
                            </div>
                        </div>
                    </div>

                    <div class="col">
                        <div class="card h-100">
                            <img src="~/Images/Assets/Alien TreeOld48.png" class="card-img-top" alt="Old Tree" style="height: 200px; object-fit: contain;" />
                            <div class="card-body">
                                <h5 class="card-title">Alien Tree V1</h5>
                                <p class="card-text">This a tree from the alien planet of our game. After recieving some feedback we changed it to match the new grass colors</p>
                            </div>
                        </div>
                    </div>

                    <div class="col">
                        <div class="card h-100">
                            <img src="~/Images/Assets/Alien TreeF48.png" class="card-img-top" alt="Alien Tree" style="height: 200px; object-fit: contain;" />
                            <div class="card-body">
                                <h5 class="card-title">Alien Tree V2</h5>
                                <p class="card-text">This a tree from the alien planet of our game. After recieving some feedback this one quickly became a fan favorite people love sleeping under it while not under attack from glorpy aliens</p>
                            </div>
                        </div>
                    </div>

                    <div class="col">
                        <div class="card h-100">
                            <img src="~/Images/Assets/HumanOld48.png" class="card-img-top" alt="PlayerOld" style="height: 200px; object-fit: contain;" />
                            <div class="card-body">
                                <h5 class="card-title">Human V1</h5>
                                <p class="card-text">This an original image of the human you play as in the game!</p>
                            </div>
                        </div>
                    </div>

                    <div class="col">
                        <div class="card h-100">
                            <img src="~/Images/Assets/Human48.png" class="card-img-top" alt="Player" style="height: 200px; object-fit: contain;" />
                            <div class="card-body">
                                <h5 class="card-title">Human V2</h5>
                                <p class="card-text">This an update the player character that we are testing and waiting to recieve feedback on!</p>
                            </div>
                        </div>
                    </div>
                </div>


            </div>
        </div>
    </div>




    <div class="accordion-item">
        <h2 class="accordion-header " id="panelsStayOpen-headingThree">
            <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#panelsStayOpen-collapseThree" aria-expanded="false" aria-controls="panelsStayOpen-collapseThree">
                <strong> Grumpy Mage</strong>
            </button>
        </h2>
        <div id="panelsStayOpen-collapseThree" class="accordion-collapse collapse" aria-labelledby="panelsStayOpen-headingTwo">
            <div class="accordion-body  text-center">
                <strong>This game is too early in development to show off assests here are a few</strong>

                <div class="d-flex justify-content-center">
                    <div class="card h-100 row justify-content-center" style="width:750px;">
                        <img src="~/Images/A Mage Game Box.png" class="card-img-top" alt="Grumpy Mage" style="height: 500px; object-fit:fill;" />
                        <div class="card-body">
                            <h5 class="card-title">Grumpy Mage Poster</h5>
                        </div>
                    </div>
                </div>
                
            </div>
        </div>
    </div>


    
    <div class="accordion-item">
        <h2 class="accordion-header " id="panelsStayOpen-headingFour">
            <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#panelsStayOpen-collapseFour" aria-expanded="false" aria-controls="panelsStayOpen-collapseFour">
                <strong>PhasmoKaisen</strong>
            </button>
        </h2>
        <div id="panelsStayOpen-collapseFour" class="accordion-collapse collapse" aria-labelledby="panelsStayOpen-headingTwo">
            <div class="accordion-body  text-center">
                <strong>This game is too early in development to show off assests here are a few</strong>
                    <div class="d-flex justify-content-center">
                        <div class="card h-100 row justify-content-center" style="width:750px;">
                            <img src="~/Images/Fake StolenPhasmoKaisen.jpg" class="card-img-top" alt="PhasmoKaisen" style="height: 500px; object-fit: cover;" />
                            <div class="card-body">
                                <h5 class="card-title">PhasmoKaisen Poster</h5>
                            </div>
                        </div>
                    </div>
            </div>
        </div>
    </div>
</div>